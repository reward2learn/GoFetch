# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://...

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret

# ── Web3 / Wallet ──────────────────────────────────────────────────────────
NEXT_PUBLIC_REOWN_PROJECT_ID=your-reown-project-id
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634c722303754C762b5cB287
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x... # Set after deploying Escrow.sol

# ── Deployer (for Hardhat only, never commit) ──────────────────────────────
DEPLOYER_PRIVATE_KEY=0x... # Private key with ETH on Base Sepolia

# ── Tenant Config ──────────────────────────────────────────────────────────
NEXT_PUBLIC_TENANT_SLUG=gofetch
NEXT_PUBLIC_APP_NAME=GoFetch
NEXT_PUBLIC_PRIMARY_COLOR=#2A5A4A
NEXT_PUBLIC_SECONDARY_COLOR=#C97A5E
NEXT_PUBLIC_WEB3_WALLET_ENABLED=true

# ── Google OAuth (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
